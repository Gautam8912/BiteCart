{
  "name": "food-express",
  "version": "1.0.0",
  "private": true,
  "description": "Food Express \u2014 premium all-in-one delivery & shopping platform (food, groceries, daily essentials, electronics).",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "seed": "node server/db/index.js --force",
    "build": "vite build --config client/vite.config.js",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "preview": "concurrently -n server,client -c cyan,magenta \"npm:start\" \"vite preview --config client/vite.config.js\"",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "test:unit": "node --test tests/pricing.test.mjs",
    "test:api": "node --test tests/api.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
