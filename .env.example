# ---------------------------------------------------------------------------
# Food Express — environment template
#
# Copy to .env and fill in. NOTHING here is committed with a real value, and
# the app refuses to boot in production without FE_JWT_SECRET.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- server ---------------------------------------------------------------
# Port the API (and, in production, the built SPA) listens on.
PORT=4000

# REQUIRED. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
FE_JWT_SECRET=

# SQLite file. Created and seeded automatically on first run.
FE_DB_PATH=server/db/data/foodexpress.db

# Cookie hardening. Set to 'production' behind HTTPS so the session cookie is
# marked Secure. Leave unset in local development (http://localhost).
FE_COOKIE_SECURE=

# Trusted reverse proxy, when running behind nginx/Caddy/a platform router.
# Without this, Express reports the wrong protocol and Secure cookies break.
# FE_TRUST_PROXY=1

# --- demo accounts (development only) --------------------------------------
# The seed creates two accounts. Change these before deploying anywhere public,
# or delete the demo accounts entirely.
FE_DEMO_ADMIN_PASSWORD=Admin@12345
FE_DEMO_CUSTOMER_PASSWORD=Customer@12345

# --- rate limiting ----------------------------------------------------------
# Auth attempts per 15 minutes per IP. The integration test suite raises this;
# production should keep it low.
FE_AUTH_RATE_LIMIT=25

# --- client (development only) ---------------------------------------------
# Where the Vite dev server proxies /api. Only needed if the API is not on
# http://127.0.0.1:4000.
# FE_API_URL=http://127.0.0.1:4000

# --- NOT YET IMPLEMENTED ---------------------------------------------------
# These are the integrations the brief asks for that need a real provider.
# The routes exist and fail loudly with 501 PROVIDER_NOT_CONFIGURED rather
# than pretending to work. See README → "Backend configuration still needed".
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
