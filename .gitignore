# --- dependencies ----------------------------------------------------------
node_modules/
.pnp
.pnp.js

# --- builds ----------------------------------------------------------------
client/dist/
dist/
build/

# --- environment & secrets (NEVER commit these) ----------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
service-account*.json

# --- database --------------------------------------------------------------
# The SQLite file is generated by `npm run seed` and holds no source data.
server/db/data/*.db
server/db/data/*.db-journal
server/db/data/*.db-wal
server/db/data/*.db-shm

# --- logs & runtime --------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
tmp-*

# --- test & coverage artifacts ---------------------------------------------
coverage/
.nyc_output/

# --- editors & OS ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
